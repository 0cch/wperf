{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0cch/wperf/schemas/diagnostic-execution.schema.json",
  "title": "wperf diagnostic-execution",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    {
      "type": "object",
      "required": [
        "rows",
        "quality"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "quality": {
          "type": "object",
          "required": [
            "lost_events",
            "lost_buffers",
            "decode_errors",
            "diagnostic_unsupported",
            "incomplete"
          ],
          "properties": {
            "incomplete": {
              "type": "boolean"
            },
            "diagnostic_unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "analysis": {
              "type": "object",
              "properties": {
                "unmatched_frees": {
                  "type": "integer",
                  "minimum": 0
                },
                "address_reuse": {
                  "type": "integer",
                  "minimum": 0
                },
                "unmatched_entries": {
                  "type": "integer",
                  "minimum": 0
                },
                "unmatched_returns": {
                  "type": "integer",
                  "minimum": 0
                },
                "duplicate_entries": {
                  "type": "integer",
                  "minimum": 0
                },
                "completion_points": {
                  "type": "integer",
                  "minimum": 0
                },
                "budget_dropped": {
                  "type": "integer",
                  "minimum": 0
                },
                "missing_stacks": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "kind",
        "cpu",
        "pid",
        "tid",
        "owner",
        "dso",
        "symbol",
        "semantics",
        "process_start_ns",
        "routine",
        "count",
        "inclusive_ns",
        "busy_ns",
        "max_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "major",
        "minor",
        "context_basis"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dpc",
            "timer-dpc",
            "threaded-dpc",
            "isr",
            "driver-dispatch",
            "driver-complete"
          ]
        },
        "cpu": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "owner": {
          "enum": [
            "system",
            "entry-context"
          ]
        },
        "dso": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "semantics": {
          "enum": [
            "inclusive-execution-span",
            "observed-call-span"
          ]
        },
        "process_start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "routine": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "inclusive_ns": {
          "type": "integer",
          "minimum": 0
        },
        "busy_ns": {
          "type": "integer",
          "minimum": 0
        },
        "max_ns": {
          "type": "integer",
          "minimum": 0
        },
        "p50_ns": {
          "type": "integer",
          "minimum": 0
        },
        "p95_ns": {
          "type": "integer",
          "minimum": 0
        },
        "p99_ns": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "context_basis": {
          "enum": [
            "system",
            "event-header",
            "thread-lifecycle",
            "scheduler",
            "unavailable"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
