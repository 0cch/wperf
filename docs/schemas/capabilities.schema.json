{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0cch/wperf/schemas/capabilities.schema.json",
  "title": "wperf capabilities",
  "type": "object",
  "required": ["schema_version", "tool_version", "commands", "global_options", "agent_guidance"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "tool_version": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "aliases", "description", "usage", "requires_elevation", "supports_json", "may_mutate_global_state", "options", "examples", "notes", "agent_hints"],
        "properties": {
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "usage": { "type": "string" },
          "requires_elevation": { "type": "boolean" },
          "supports_json": { "type": "boolean" },
          "may_mutate_global_state": { "type": "boolean" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["names", "value", "description", "optional_value"],
              "properties": {
                "names": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "value": { "type": "string" },
                "description": { "type": "string" },
                "optional_value": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "examples": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } },
          "agent_hints": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "global_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["names", "description", "position"],
        "properties": {
          "names": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "position": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "agent_guidance": {
      "type": "object",
      "required": ["artifact_first", "notes"],
      "properties": {
        "artifact_first": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}