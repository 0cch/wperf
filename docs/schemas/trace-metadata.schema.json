{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0cch/wperf/schemas/trace-metadata.schema.json",
  "title": "wperf trace metadata output",
  "type": "object",
  "required": [
    "events",
    "truncated",
    "quality"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "cpu",
          "pid",
          "tid",
          "event",
          "value1",
          "value2",
          "related_tid",
          "related_pid",
          "status",
          "has_status",
          "duration_ns",
          "has_duration",
          "size",
          "offset",
          "correlation_id",
          "wait_reason",
          "previous_state",
          "flags",
          "file_path",
          "detail",
          "comm"
        ],
        "properties": {
          "ts": {
            "type": "integer",
            "minimum": 0
          },
          "cpu": {
            "type": "integer",
            "minimum": 0
          },
          "pid": {
            "type": "integer",
            "minimum": 0
          },
          "tid": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string"
          },
          "value1": {
            "type": "integer"
          },
          "value2": {
            "type": "integer"
          },
          "related_tid": {
            "type": "integer",
            "minimum": 0
          },
          "related_pid": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "integer"
          },
          "has_status": {
            "type": "boolean"
          },
          "duration_ns": {
            "type": "integer",
            "minimum": 0
          },
          "has_duration": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer"
          },
          "correlation_id": {
            "type": "integer"
          },
          "wait_reason": {
            "type": "integer",
            "minimum": 0
          },
          "previous_state": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "integer",
            "minimum": 0
          },
          "file_path": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "comm": {
            "type": "string"
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pmc_counters": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stack_assessment": {
          "enum": [
            "loaded",
            "not-loaded"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
