{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0cch/wperf/schemas/stat.schema.json",
  "title": "wperf stat output",
  "type": "object",
  "oneOf": [
    {
      "required": ["source", "target_pid", "target_exit_code", "elapsed_ms", "user_ms", "sys_ms", "cycles", "page_faults", "io_read_ops", "io_read_bytes", "io_write_ops", "io_write_bytes", "samples"],
      "properties": {
        "source": { "const": "windows-api" },
        "target_pid": { "type": "integer", "minimum": 0 },
        "target_exit_code": { "type": ["integer", "null"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "user_ms": { "type": "integer", "minimum": 0 },
        "sys_ms": { "type": "integer", "minimum": 0 },
        "cycles": { "type": ["integer", "null"] },
        "page_faults": { "type": "integer", "minimum": 0 },
        "io_read_ops": { "type": "integer", "minimum": 0 },
        "io_read_bytes": { "type": "integer", "minimum": 0 },
        "io_write_ops": { "type": "integer", "minimum": 0 },
        "io_write_bytes": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    {
      "required": ["source", "exact", "profile_source", "source_name", "sampling_period", "target_pid", "sample_count", "samples", "quality"],
      "properties": {
        "source": { "const": "etw-pmc-sampling" },
        "exact": { "const": false },
        "profile_source": { "type": "integer", "minimum": 0 },
        "source_name": { "type": "string" },
        "sampling_period": { "type": "integer", "minimum": 0 },
        "target_pid": { "type": "integer", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "quality": { "type": "object", "additionalProperties": true }
      }
    }
  ],
  "additionalProperties": true
}
