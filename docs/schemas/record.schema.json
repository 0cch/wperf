{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0cch/wperf/schemas/record.schema.json",
  "title": "wperf record success",
  "type": "object",
  "required": ["ok", "schema_version", "tool_version", "command", "status", "session", "correlation_id", "trace", "profile", "sample_frequency_hz", "duration_ms", "target_pid", "target_exit_code", "trace_size_bytes", "quality"],
  "properties": {
    "ok": { "const": true },
    "schema_version": { "type": "integer", "minimum": 1 },
    "tool_version": { "type": "string" },
    "command": { "const": "record" },
    "status": { "const": "complete" },
    "session": { "type": "string" },
    "correlation_id": { "type": "string" },
    "trace": { "type": "string" },
    "profile": { "type": "string" },
    "event": { "type": "string" },
    "sample_frequency_hz": { "type": ["integer", "null"], "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "target_pid": { "type": ["integer", "null"], "minimum": 0 },
    "target_exit_code": { "type": ["integer", "null"], "minimum": 0 },
    "trace_size_bytes": { "type": "integer", "minimum": 0 },
    "quality": {
      "type": "object",
      "required": ["evaluated", "note"],
      "properties": {
        "evaluated": { "const": false },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}